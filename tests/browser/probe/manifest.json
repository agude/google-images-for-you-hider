{
  "manifest_version": 3,
  "name": "Navigation event probe",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": { "id": "navigation-probe@example.invalid" }
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/search*"],
      "js": ["probe.js"],
      "run_at": "document_start"
    }
  ]
}
